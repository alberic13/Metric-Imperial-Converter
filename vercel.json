{
  "version": 2,
  "env": {
    "NODE_ENV": "test"
  },
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "views/**",
          "public/**",
          "tests/**",
          "controllers/**",
          "routes/**",
          "assertion-analyser.js",
          "test-runner.js",
          "test-report.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
